[Unit]
Description=wolweb – Wake on LAN mit Weboberfläche
After=network-online.target
Wants=network-online.target

[Service]
User=wolweb
Group=wolweb
WorkingDirectory=/opt/wolweb
ExecStart=/opt/wolweb/wolweb -c /opt/wolweb/config.json
Restart=on-failure
# ARP-Scan und Ping ohne root:
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/wolweb/data
PrivateTmp=true

[Install]
WantedBy=multi-user.target
